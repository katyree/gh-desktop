<Window
    x:Class="WinGit.Native.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WinGit.Native"
    mc:Ignorable="d"
    Title="WinGit">
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="22" />
            </Style>
            <DataTemplate x:Key="RepositoryChooserRowTemplate">
                <Grid Padding="8,6" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Remove"
                            Tag="{Binding}"
                            Click="RepositoryChooserRemoveButton_Click"
                            Visibility="{Binding RemoveVisibility}"
                            AutomationProperties.Name="Remove unavailable repository" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="RepositoryRecentRowTemplate">
                <Grid Padding="8,6" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Path}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Rename"
                            Tag="{Binding}"
                            Click="RecentRepositoryRenameButton_Click"
                            AutomationProperties.Name="Rename repository alias" />
                    <Button Grid.Column="2"
                            Content="Remove"
                            Tag="{Binding}"
                            Click="RecentRepositoryRemoveButton_Click"
                            AutomationProperties.Name="Remove repository from recents" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ChangeRowTemplate">
                <Grid MinHeight="62" Padding="10,8" AutomationProperties.Name="{Binding Path}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding KindGlyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DiffRowTemplate">
                <Grid MinWidth="850" MinHeight="24" Padding="0" AutomationProperties.Name="{Binding KindLabel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="4" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{Binding AddedVisibility}" />
                    <Border Grid.ColumnSpan="4" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{Binding RemovedVisibility}" />
                    <Border Grid.ColumnSpan="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{Binding SectionVisibility}" />
                    <TextBlock Text="{Binding OldLineNumber}" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding NewLineNumber}" HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Marker}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding NeutralMarkerVisibility}" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Marker}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{Binding AddedMarkerVisibility}" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Marker}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="{Binding RemovedMarkerVisibility}" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Padding="0" Margin="0" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="NoWrap" VerticalAlignment="Center" AutomationProperties.Name="{Binding KindLabel}" Loaded="DiffTextBlock_Loaded" DataContextChanged="DiffTextBlock_DataContextChanged" />
                    <Border Grid.ColumnSpan="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.6" IsHitTestVisible="False" Visibility="{Binding SearchMatchVisibility}" />
                    <Border Grid.ColumnSpan="4" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.35" IsHitTestVisible="False" Visibility="{Binding CurrentSearchMatchVisibility}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="DiffSideBySideRowTemplate">
                <Grid MinHeight="24" Padding="0" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding KindLabel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{Binding OldRemovedVisibility}" />
                    <Border Grid.Column="3" Grid.ColumnSpan="3" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{Binding NewAddedVisibility}" />
                    <Border Grid.ColumnSpan="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{Binding HeaderVisibility}" />
                    <TextBlock Grid.Column="0" Text="{Binding OldLineNumber}" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono" FontSize="12" VerticalAlignment="Center" Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="1" Text="{Binding OldMarker}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="2" Tag="Old" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{Binding OldText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding LineVisibility}" Loaded="DiffTextBlock_Loaded" DataContextChanged="DiffTextBlock_DataContextChanged" />
                    <TextBlock Grid.Column="3" Text="{Binding NewLineNumber}" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontFamily="Cascadia Mono" FontSize="12" VerticalAlignment="Center" Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="4" Text="{Binding NewMarker}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontFamily="Cascadia Mono" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="5" Tag="New" IsTextSelectionEnabled="True" ToolTipService.ToolTip="{Binding NewText}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="{Binding LineVisibility}" Loaded="DiffTextBlock_Loaded" DataContextChanged="DiffTextBlock_DataContextChanged" />
                    <TextBlock Grid.ColumnSpan="6" Text="{Binding Header}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Header}" VerticalAlignment="Center" Visibility="{Binding HeaderVisibility}" />
                    <Border Grid.ColumnSpan="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Opacity="0.6" IsHitTestVisible="False" Visibility="{Binding SearchMatchVisibility}" />
                    <Border Grid.ColumnSpan="6" Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.35" IsHitTestVisible="False" Visibility="{Binding CurrentSearchMatchVisibility}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="PartialDiffRowTemplate">
                <Grid MinWidth="900" MinHeight="24" Padding="0" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="5" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="{Binding HunkVisibility}" />
                    <Border Grid.ColumnSpan="5" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{Binding AddedVisibility}" />
                    <Border Grid.ColumnSpan="5" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{Binding RemovedVisibility}" />
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              IsThreeState="{Binding IsHunk}"
                              IsEnabled="{Binding CanSelect}"
                              Click="PartialRowCheckBox_Click"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="{Binding SelectableVisibility}"
                              AutomationProperties.Name="{Binding SelectionAutomationName}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding OldLineNumber}"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding NewLineNumber}"
                               HorizontalAlignment="Right"
                               Margin="0,0,12,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="3"
                               Text="{Binding Marker}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Visibility="{Binding LineVisibility}" />
                    <TextBlock Grid.Column="4"
                               Text="{Binding Text, Mode=OneWay}"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               TextWrapping="NoWrap"
                               VerticalAlignment="Center"
                               Visibility="{Binding LineVisibility}"
                               AutomationProperties.Name="{Binding AutomationName}" />
                    <TextBlock Grid.Column="1"
                               Grid.ColumnSpan="4"
                               Text="{Binding Header}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               FontFamily="Cascadia Mono"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Visibility="{Binding HunkVisibility}"
                               AutomationProperties.Name="{Binding AutomationName}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ConflictHunkTemplate">
                <Border Margin="0,0,0,10"
                        Padding="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="6"
                        AutomationProperties.Name="{Binding Title}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Content="Use ours"
                                         Click="ConflictUseOursButton_Click"
                                         AutomationProperties.Name="Use ours for this conflict" />
                                <Button Content="Use theirs"
                                         Click="ConflictUseTheirsButton_Click"
                                         AutomationProperties.Name="Use theirs for this conflict" />
                                <Button Content="Use both"
                                        Click="ConflictUseBothButton_Click"
                                        AutomationProperties.Name="Use both sides for this conflict" />
                            </StackPanel>
                        </Grid>
                        <Border Padding="8,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding ContextBeforeVisibility}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Context before" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{Binding ContextBefore}"
                                           IsTextSelectionEnabled="True"
                                           FontFamily="Cascadia Mono"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Padding="8,6" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Ours"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OursContent}"
                                               IsTextSelectionEnabled="True"
                                               FontFamily="Cascadia Mono"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Padding="8,6" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Theirs"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TheirsContent}"
                                               IsTextSelectionEnabled="True"
                                               FontFamily="Cascadia Mono"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Padding="8,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding BaseVisibility}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Base (diff3)" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{Binding BaseContent}"
                                           IsTextSelectionEnabled="True"
                                           FontFamily="Cascadia Mono"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Resolved text"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   FontWeight="SemiBold" />
                        <TextBox Text="{Binding ResolvedContent, Mode=OneWay}"
                                 TextChanged="ConflictResolvedTextBox_TextChanged"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="64"
                                 MaxHeight="180"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Resolved text for conflict hunk" />
                        <Border Padding="8,6"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding ContextAfterVisibility}">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Context after" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{Binding ContextAfter}"
                                           IsTextSelectionEnabled="True"
                                           FontFamily="Cascadia Mono"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="CommitRowTemplate">
                <Grid MinHeight="70" Padding="12,9" AutomationProperties.Name="{Binding Summary}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top" ToolTipService.ToolTip="{Binding Commit.Id}">
                        <TextBlock Text="{Binding ShortId}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Author}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding Date}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ReflogRowTemplate">
                <Grid MinHeight="70" Padding="12,8" AutomationProperties.Name="{Binding AutomationName}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Subject}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Details}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CommitId}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="CommitFileRowTemplate">
                <Grid MinHeight="48" Padding="12,7" AutomationProperties.Name="{Binding Path}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding KindGlyph}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="HistoryComparisonBranchRowTemplate">
                <Grid MinHeight="44" Padding="10,6" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="BranchRowTemplate">
                <Grid MinHeight="68" Padding="12,9" AutomationProperties.Name="{Binding Name}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Marker}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding TrackingLabel}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="WorktreeRowTemplate">
                <Grid MinHeight="76" Padding="12,9" AutomationProperties.Name="{Binding Path}">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Branch}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SubmoduleRowTemplate">
                <Grid MinHeight="76" Padding="12,9" AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26"
                            Height="26"
                            CornerRadius="6"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusGlyph}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="{Binding Path}"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding RevisionLabel}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   FontFamily="Cascadia Mono"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="StashRowTemplate">
                <Grid MinHeight="72" Padding="12,9" AutomationProperties.Name="{Binding Reference}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="66" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top" ToolTipService.ToolTip="{Binding CommitId}">
                        <TextBlock Text="{Binding Reference}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Date}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding CommitId}" Style="{StaticResource SecondaryTextStyle}" FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="RemoteRowTemplate">
                <Grid MinHeight="72" Padding="12,9" AutomationProperties.Name="{Binding Name}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Url}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Url}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="TagRowTemplate">
                <Grid MinHeight="72" Padding="12,9" AutomationProperties.Name="{Binding Name}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="68" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="58" Height="26" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top" ToolTipService.ToolTip="{Binding ObjectId}">
                        <TextBlock Text="tag" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontFamily="Cascadia Mono" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" Spacing="3">
                        <TextBlock Text="{Binding Name}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding KindLabel}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Text="{Binding TargetLabel}" Style="{StaticResource SecondaryTextStyle}" FontFamily="Cascadia Mono" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,150,0" VerticalAlignment="Top" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/icon-logo.ico" Width="20" Height="20" Stretch="Uniform" AutomationProperties.Name="WinGit logo" />
            </Border>
            <TextBlock Grid.Column="1" Text="WinGit" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Grid.Column="2" Text="Native preview" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
        </Grid>

        <MenuBar Grid.Row="1" AutomationProperties.Name="Application menu">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Create repository…"
                                Tag="CreateRepository"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Open repository…"
                                Tag="OpenRepository"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Clone repository…"
                                Tag="CloneRepository"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="OpenRepositoryEditorMenuItem"
                                Text="Open repository in editor"
                                Tag="OpenRepositoryEditor"
                                Click="IntegrationMenuItem_Click" />
                <MenuFlyoutItem x:Name="OpenSelectedFileEditorMenuItem"
                                Text="Open selected file in editor"
                                Tag="OpenSelectedFileEditor"
                                Click="IntegrationMenuItem_Click" />
                <MenuFlyoutItem x:Name="OpenRepositoryShellMenuItem"
                                Text="Open repository shell"
                                Tag="OpenRepositoryShell"
                                Click="IntegrationMenuItem_Click" />
                <MenuFlyoutItem x:Name="RevealRepositoryMenuItem"
                                Text="Reveal repository in File Explorer"
                                Tag="RevealRepository"
                                Click="IntegrationMenuItem_Click" />
                <MenuFlyoutItem x:Name="RevealSelectedFileMenuItem"
                                Text="Reveal selected file in File Explorer"
                                Tag="RevealSelectedFile"
                                Click="IntegrationMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SettingsMenuItem"
                                Text="Settings"
                                Tag="Settings"
                                Click="AppCommandMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Changes"
                                Tag="Changes"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number1" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="History"
                                Tag="History"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Number2" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Repository chooser"
                                Tag="ChooseRepository"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Branches"
                                Tag="Branches"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Worktrees &amp; stashes"
                                Tag="Worktrees"
                                Click="AppCommandMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control,Menu" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <NavigationView x:Name="MainNavigation" Grid.Row="2" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" IsPaneToggleButtonVisible="True" OpenPaneLength="200" PaneDisplayMode="LeftCompact" SelectionChanged="MainNavigation_SelectionChanged" AutomationProperties.Name="WinGit navigation">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Changes" Tag="changes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Document" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Branches" Tag="branches">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Worktrees &amp; stashes" Tag="worktrees">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Submodules" Tag="submodules">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Folder" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Remotes" Tag="remotes">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Link" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Tags" Tag="tags">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Tag" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid x:Name="WorkspaceRoot" Padding="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="54" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Padding="12,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="RepositoryChooserButton"
                                    AutomationProperties.Name="Choose repository">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="▣" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RepositoryChooserLabel"
                                               Text="Choose repository"
                                               MaxWidth="180"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenRepositoryButton" Click="OpenRepositoryButton_Click" AutomationProperties.Name="Open repository">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="▣" FontSize="15" VerticalAlignment="Center" />
                                    <TextBlock Text="Open repository" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CreateRepositoryButton" Content="Create" Click="CreateRepositoryButton_Click" AutomationProperties.Name="Create repository" />
                            <Button x:Name="CloneRepositoryButton" Content="Clone" Click="CloneRepositoryButton_Click" AutomationProperties.Name="Clone repository" />
                            <Button x:Name="RefreshButton" Click="RefreshButton_Click" AutomationProperties.Name="Refresh repository">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="↻" FontSize="17" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StageButton" Click="StageButton_Click" AutomationProperties.Name="Stage selected files">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="↑" FontSize="17" VerticalAlignment="Center" />
                                    <TextBlock Text="Stage selected" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UnstageButton" Click="UnstageButton_Click" AutomationProperties.Name="Unstage selected files">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Text="↓" FontSize="17" VerticalAlignment="Center" />
                                    <TextBlock Text="Unstage selected" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="CancelOperationButton" Content="Cancel" Click="CancelOperationButton_Click" Visibility="Collapsed" AutomationProperties.Name="Cancel current operation" />
                            <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="12,0,12,8" IsOpen="False" IsClosable="True" Severity="Error" Closing="ErrorBar_Closing" AutomationProperties.Name="Repository error" />

                    <Grid x:Name="RepositoryHeader" Grid.Row="2" Padding="18,8,18,12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="RepositoryPathText" Text="Choose a repository to begin" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BranchText" Text="" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock Text="CHANGES" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock x:Name="ChangeCountText" Text="0" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Text="SYNC" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock x:Name="SyncText" Text="—" HorizontalAlignment="Right" FontSize="15" FontWeight="SemiBold" />
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="GitOperationPanel"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,0"
                                Padding="12,10"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="8"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Active Git operation">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="GitOperationTitle"
                                                   Text="Git operation in progress"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   AutomationProperties.Name="Git operation type" />
                                        <TextBlock x:Name="GitOperationProgressText"
                                                   Text=""
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   AutomationProperties.Name="Git operation progress" />
                                    </StackPanel>
                                    <Button x:Name="RefreshGitOperationButton"
                                            Grid.Column="1"
                                            Content="Refresh"
                                            Click="RefreshGitOperationButton_Click"
                                            AutomationProperties.Name="Refresh active Git operation" />
                                </Grid>
                                <TextBlock x:Name="GitOperationMessageText"
                                           Text=""
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />
                                <ListView x:Name="GitOperationConflictList"
                                          MaxHeight="96"
                                          Visibility="Collapsed"
                                          SelectionMode="Single"
                                          SelectionChanged="GitOperationConflictList_SelectionChanged"
                                          ItemContainerStyle="{StaticResource ListItemStyle}"
                                          AutomationProperties.Name="Git operation conflict paths">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path}"
                                                       Padding="4,2"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       AutomationProperties.Name="{Binding Path}" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="GitOperationConflictHint"
                                           Text="Select a path to inspect its diff in Changes. Resolve and stage paths explicitly before continuing."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ContinueGitOperationButton"
                                            Content="Continue"
                                            Click="ContinueGitOperationButton_Click"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Continue active Git operation" />
                                    <Button x:Name="SkipGitOperationButton"
                                            Content="Skip commit"
                                            Click="SkipGitOperationButton_Click"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Skip current rebase commit" />
                                    <Button x:Name="AbortGitOperationButton"
                                            Content="Abort"
                                            Click="AbortGitOperationButton_Click"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Abort active Git operation" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="ChangesWorkspace" Grid.Row="3" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Padding="8,0,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="150" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="8,0">
                                <TextBlock Text="Working changes" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FilteredChangeCountText" Text="" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBox x:Name="ChangesFilterBox" Grid.Row="1" Margin="8,0,8,8" PlaceholderText="Filter paths" TextChanged="ChangesFilterBox_TextChanged" AutomationProperties.Name="Filter changed files" />
                            <Grid Grid.Row="2" Padding="8,0">
                                <TextBlock Text="Staged" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="UnstageAllButton"
                                            Content="Unstage all"
                                            Click="UnstageAllButton_Click"
                                            AutomationProperties.Name="Unstage all visible files" />
                                    <TextBlock x:Name="StagedCountText"
                                               Text="0"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="StagedChangesList" Grid.Row="3" ItemTemplate="{StaticResource ChangeRowTemplate}" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionChanged="StagedChangesList_SelectionChanged" SelectionMode="Multiple" AutomationProperties.Name="Staged changed files" />
                            <Grid Grid.Row="4" Padding="8,0">
                                <TextBlock Text="Unstaged" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="StageAllButton"
                                            Content="Stage all"
                                            Click="StageAllButton_Click"
                                            AutomationProperties.Name="Stage all visible files" />
                                    <TextBlock x:Name="UnstagedCountText"
                                               Text="0"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ListView x:Name="UnstagedChangesList" Grid.Row="5" ItemTemplate="{StaticResource ChangeRowTemplate}" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionChanged="UnstagedChangesList_SelectionChanged" SelectionMode="Multiple" AutomationProperties.Name="Unstaged changed files" />
                        </Grid>
                        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Grid.Column="2" Padding="18,0,18,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="48" />
                                <RowDefinition Height="*" />
                                 <RowDefinition x:Name="ChangesCommitRow" Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="DiffFileText" Text="Select a changed file" Style="{StaticResource PanelTitleStyle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DiffSummaryText" Text="" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button x:Name="OpenConflictEditorButton"
                                            Content="Open conflict editor"
                                            Click="OpenConflictEditorButton_Click"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Open conflict editor" />
                                    <CommandBar x:Name="IntegrationActionBar"
                                                Padding="0"
                                                IsDynamicOverflowEnabled="True"
                                                Background="Transparent"
                                                AutomationProperties.Name="External tool actions">
                                        <CommandBar.PrimaryCommands>
                                            <AppBarButton x:Name="OpenSelectedFileEditorButton"
                                                          Label="Open file"
                                                          Click="OpenSelectedFileEditorButton_Click"
                                                          AutomationProperties.Name="Open selected file in editor">
                                                <AppBarButton.Icon>
                                                    <SymbolIcon Symbol="Document" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton x:Name="RevealSelectedFileButton"
                                                          Label="Reveal file"
                                                          Click="RevealSelectedFileButton_Click"
                                                          AutomationProperties.Name="Reveal selected file in File Explorer">
                                                <AppBarButton.Icon>
                                                    <SymbolIcon Symbol="Folder" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                        </CommandBar.PrimaryCommands>
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton x:Name="OpenRepositoryEditorButton"
                                                          Label="Open repository in editor"
                                                          Click="OpenRepositoryEditorButton_Click"
                                                          AutomationProperties.Name="Open repository in selected editor">
                                                <AppBarButton.Icon>
                                                    <SymbolIcon Symbol="Folder" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton x:Name="OpenRepositoryShellButton"
                                                          Label="Open repository shell"
                                                          Click="OpenRepositoryShellButton_Click"
                                                          AutomationProperties.Name="Open repository shell">
                                                <AppBarButton.Icon>
                                                    <SymbolIcon Symbol="Folder" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                            <AppBarButton x:Name="RevealRepositoryButton"
                                                          Label="Reveal repository"
                                                          Click="RevealRepositoryButton_Click"
                                                          AutomationProperties.Name="Reveal repository in File Explorer">
                                                <AppBarButton.Icon>
                                                    <SymbolIcon Symbol="Folder" />
                                                </AppBarButton.Icon>
                                            </AppBarButton>
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,0,0,8"
                                            AutomationProperties.Name="Changes diff controls">
                                    <TextBlock Text="View" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DiffModeComboBox"
                                              Width="110"
                                              SelectionChanged="DiffModeComboBox_SelectionChanged"
                                              AutomationProperties.Name="Changes diff view mode">
                                        <ComboBoxItem Content="Unified" Tag="Unified" />
                                        <ComboBoxItem Content="Split" Tag="Split" />
                                    </ComboBox>
                                    <CheckBox x:Name="HideWhitespaceChangesCheckBox"
                                              Content="Hide whitespace changes"
                                              Click="HideWhitespaceChangesCheckBox_Click"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Hide whitespace changes in Changes diff" />
                                    <TextBox x:Name="DiffSearchBox"
                                             Width="220"
                                             PlaceholderText="Find in diff"
                                             TextChanged="DiffSearchBox_TextChanged"
                                             KeyDown="DiffSearchBox_KeyDown"
                                             AutomationProperties.Name="Search current Changes diff" />
                                    <Button x:Name="DiffSearchPreviousButton"
                                            Content="Previous"
                                            Click="DiffSearchPreviousButton_Click"
                                            AutomationProperties.Name="Find previous Changes diff match" />
                                    <Button x:Name="DiffSearchNextButton"
                                            Content="Next"
                                            Click="DiffSearchNextButton_Click"
                                            AutomationProperties.Name="Find next Changes diff match" />
                                    <TextBlock x:Name="DiffSearchStatusText"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               VerticalAlignment="Center"
                                               AutomationProperties.Name="Changes diff search status" />
                                </StackPanel>
                                <Border x:Name="PartialSelectionBar"
                                        Grid.Row="1"
                                        Margin="0,0,0,8"
                                        Padding="10,6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="6"
                                        VerticalAlignment="Top"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PartialSelectionStatusText"
                                                   Text="Select changed lines or a whole hunk"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Partial selection status" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button x:Name="StagePartialButton"
                                                    Content="Stage lines"
                                                    Click="StagePartialButton_Click"
                                                    Visibility="Collapsed"
                                                    AutomationProperties.Name="Stage selected changed lines or hunk" />
                                            <Button x:Name="UnstagePartialButton"
                                                    Content="Unstage lines"
                                                    Click="UnstagePartialButton_Click"
                                                    Visibility="Collapsed"
                                                    AutomationProperties.Name="Unstage selected changed lines or hunk" />
                                            <Button x:Name="ClearPartialSelectionButton"
                                                    Content="Clear selection"
                                                    Click="ClearPartialSelectionButton_Click"
                                                    Visibility="Collapsed"
                                                    AutomationProperties.Name="Clear partial line selection" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2" VerticalAlignment="Stretch">
                                    <ListView x:Name="DiffList" ItemTemplate="{StaticResource DiffRowTemplate}" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionMode="None" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Working directory diff" />
                                    <ListView x:Name="DiffSideBySideList" ItemTemplate="{StaticResource DiffSideBySideRowTemplate}" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionMode="None" Visibility="Collapsed" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Working directory split diff" />
                                    <ListView x:Name="PartialDiffList"
                                              ItemTemplate="{StaticResource PartialDiffRowTemplate}"
                                               ItemContainerStyle="{StaticResource ListItemStyle}"
                                              SelectionMode="None"
                                              Visibility="Collapsed"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollMode="Enabled"
                                               ScrollViewer.VerticalScrollBarVisibility="Auto"
                                               AutomationProperties.Name="Partial working directory diff with hunk and changed line selection" />
                                     <local:NativeImageDiffView x:Name="DiffImageView"
                                                                Visibility="Collapsed"
                                                                AutomationProperties.Name="Working directory image diff" />
                                     <local:NativeSubmoduleDiffView x:Name="DiffSubmoduleView"
                                                                    Visibility="Collapsed"
                                                                    AutomationProperties.Name="Working directory submodule diff" />
                                     <StackPanel x:Name="DiffMessagePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="10" Visibility="Visible">
                                        <TextBlock x:Name="DiffMessageTitle" Text="Select a changed file" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="DiffMessageText" Text="The native diff viewer will show line numbers, context, and selected text here." Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border x:Name="ConflictEditorPanel"
                                            Padding="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Conflict editor">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <TextBlock x:Name="ConflictEditorTitle"
                                                               Text="Resolve conflict"
                                                               Style="{StaticResource PanelTitleStyle}" />
                                                    <TextBlock x:Name="ConflictEditorPathText"
                                                               Text=""
                                                               Style="{StaticResource SecondaryTextStyle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button x:Name="CloseConflictEditorButton"
                                                        Grid.Column="1"
                                                        Content="Show full diff"
                                                        Click="CloseConflictEditorButton_Click"
                                                        AutomationProperties.Name="Show full conflict diff" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Spacing="8" Margin="0,10,0,8">
                                                <TextBlock x:Name="ConflictEditorSemanticsText"
                                                           Style="{StaticResource SecondaryTextStyle}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel x:Name="ConflictStaleDraftPanel"
                                                            Spacing="4"
                                                            Visibility="Collapsed">
                                                    <TextBlock Text="Previous draft (copy before refreshing)"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                                    <TextBox x:Name="ConflictStaleDraftTextBox"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             MaxHeight="150"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             AutomationProperties.Name="Previous conflict draft, copyable" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Grid Grid.Row="2">
                                                <ListView x:Name="ConflictHunksList"
                                                          ItemTemplate="{StaticResource ConflictHunkTemplate}"
                                                          ItemContainerStyle="{StaticResource ListItemStyle}"
                                                          SelectionMode="None"
