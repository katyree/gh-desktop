                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Padding="8,0,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>
                            <Grid Padding="8,0">
                                <TextBlock Text="Remotes" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center" />
                                <Button x:Name="AddRemoteButton" Content="Add remote" Click="AddRemoteButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Add remote" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListView x:Name="RemoteList" ItemTemplate="{StaticResource RemoteRowTemplate}" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionChanged="RemoteList_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Git remotes" />
                                <TextBlock x:Name="RemoteEmptyText" Text="No remotes configured" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Padding="8,6">
                                <Button x:Name="EditRemoteButton" Content="Edit URL" Click="EditRemoteButton_Click" AutomationProperties.Name="Edit selected remote URL" />
                                <Button x:Name="RemoveRemoteButton" Content="Remove" Click="RemoveRemoteButton_Click" AutomationProperties.Name="Remove selected remote" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Grid.Column="2" Padding="24,18">
                            <StackPanel MaxWidth="680" Spacing="14">
                                <TextBlock Text="Remote transport" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock x:Name="SelectedRemoteNameText" Text="Select a remote" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedRemoteUrlText" Text="Choose a remote to view its URL and run a transport action." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="RemoteTransportBranchText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                    <Button x:Name="FetchRemoteButton" Content="Fetch" Click="FetchRemoteButton_Click" AutomationProperties.Name="Fetch selected remote" />
                                    <Button x:Name="PullRemoteButton" Content="Pull (fast-forward only)" Click="PullRemoteButton_Click" AutomationProperties.Name="Pull selected remote fast-forward only" />
                                    <Button x:Name="PushRemoteButton" Content="Push" Click="PushRemoteButton_Click" AutomationProperties.Name="Push selected remote" />
                                    <Button x:Name="BrowsePullRequestsButton" Content="Browse pull requests" Click="BrowsePullRequestsButton_Click" AutomationProperties.Name="Browse pull requests for selected remote" />
                                </StackPanel>
                                <TextBlock Text="Fetch, pull, and push always name the selected remote and target branch. Pull refuses divergence instead of rebasing or forcing; push never uses force." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="TagsWorkspace" Grid.Row="3" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="390" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Padding="8,0,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="8,0">
                                <TextBlock Text="Tags" Style="{StaticResource PanelTitleStyle}" VerticalAlignment="Center" />
                                <Button x:Name="CreateTagButton" Content="New tag" Click="CreateTagButton_Click" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Create local tag" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListView x:Name="TagsList" ItemTemplate="{StaticResource TagRowTemplate}" ItemContainerStyle="{StaticResource ListItemStyle}" SelectionChanged="TagsList_SelectionChanged" SelectionMode="Single" AutomationProperties.Name="Local tags" />
                                <TextBlock x:Name="TagsEmptyText" Text="No local tags" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                        <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Grid.Column="2" Padding="24,18">
                            <StackPanel MaxWidth="680" Spacing="14">
                                <TextBlock Text="Tag details" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock x:Name="SelectedTagNameText" Text="Select a tag" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedTagKindText" Text="Choose a local tag to inspect its target." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SelectedTagTargetText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SelectedTagObjectText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" FontFamily="Cascadia Mono" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                    <Button x:Name="DeleteTagButton" Content="Delete tag" Click="DeleteTagButton_Click" AutomationProperties.Name="Delete selected local tag" />
                                </StackPanel>
                                <TextBlock Text="Deleting a tag removes its local reference. The commit it points to remains in the repository." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SettingsWorkspace" Grid.Row="3" Padding="30,18" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="820" Spacing="14">
                                <TextBlock Text="Settings" Style="{StaticResource PanelTitleStyle}" />
                                <TextBlock Text="Native preferences are stored separately for this WinUI app." Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <ComboBox x:Name="ThemeComboBox" Width="220" SelectedValuePath="Tag" SelectionChanged="ThemeComboBox_SelectionChanged" AutomationProperties.Name="Native app theme">
                                    <ComboBoxItem Content="Use system setting" Tag="System" />
                                    <ComboBoxItem Content="Light" Tag="Light" />
                                    <ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>

                                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="External tools" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="Choose an installed supported editor and shell for repository actions." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="RefreshIntegrationsButton"
                                                    Grid.Column="1"
                                                    Content="Refresh"
                                                    Click="RefreshIntegrationsButton_Click"
                                                    VerticalAlignment="Top"
                                                    AutomationProperties.Name="Refresh supported external tools" />
                                        </Grid>
                                        <TextBlock Text="Editor" FontWeight="SemiBold" />
                                        <ComboBox x:Name="EditorIntegrationComboBox"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="IntegrationComboBox_SelectionChanged"
                                                  AutomationProperties.Name="Selected editor" />
                                        <TextBlock x:Name="EditorIntegrationStatusText"
                                                   Text="No supported editor is installed."
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Editor discovery status" />
                                        <TextBlock x:Name="EditorIntegrationDiagnosticsText"
                                                   Text=""
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Unavailable editor choices" />
                                        <TextBlock Text="Shell" FontWeight="SemiBold" Margin="0,6,0,0" />
                                        <ComboBox x:Name="ShellIntegrationComboBox"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="IntegrationComboBox_SelectionChanged"
                                                  AutomationProperties.Name="Selected shell" />
                                        <TextBlock x:Name="ShellIntegrationStatusText"
                                                   Text="No supported shell is installed."
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Shell discovery status" />
                                        <TextBlock x:Name="ShellIntegrationDiagnosticsText"
                                                   Text=""
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Unavailable shell choices" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Git configuration" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Edit the selected Git scope. Local values apply to the open repository; global values provide the fallback for repositories without a local value." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="Scope" FontWeight="SemiBold" />
                                        <ComboBox x:Name="GitConfigScopeComboBox"
                                                  Width="260"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="GitConfigScopeComboBox_SelectionChanged"
                                                  AutomationProperties.Name="Git configuration scope">
                                            <ComboBoxItem Content="Repository local" Tag="Local" />
                                            <ComboBoxItem Content="Global Git" Tag="Global" />
                                        </ComboBox>
                                        <TextBlock x:Name="GitConfigScopeStatusText"
                                                   Text="Select a scope to read Git configuration."
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Git configuration scope status" />
                                        <TextBox x:Name="GitConfigUserNameBox"
                                                 Header="User name"
                                                 PlaceholderText="Your Git author name"
                                                 AutomationProperties.Name="Git user name" />
                                        <TextBlock x:Name="GitConfigUserNameScopeText"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Git user name scope details" />
                                        <TextBox x:Name="GitConfigUserEmailBox"
                                                 Header="User email"
                                                 PlaceholderText="you@example.com"
                                                 AutomationProperties.Name="Git user email" />
                                        <TextBlock x:Name="GitConfigUserEmailScopeText"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Git user email scope details" />
                                        <TextBox x:Name="GitConfigDefaultBranchBox"
                                                 Header="Default branch for new repositories"
                                                 PlaceholderText="main"
                                                 AutomationProperties.Name="Git default branch" />
                                        <TextBlock x:Name="GitConfigDefaultBranchScopeText"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Git default branch scope details" />
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <Button x:Name="RefreshGitConfigButton"
                                                    Content="Refresh"
                                                    Click="RefreshGitConfigButton_Click"
                                                    AutomationProperties.Name="Refresh Git configuration" />
                                            <Button x:Name="SaveGitConfigButton"
                                                    Content="Save Git configuration"
                                                    Click="SaveGitConfigButton_Click"
                                                    AutomationProperties.Name="Save Git configuration" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,12,0,0" Padding="16,14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Codex account" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="CodexAccountStatusText" Text="Not loaded" FontWeight="SemiBold" AutomationProperties.Name="Codex account status" />
                                                <TextBlock x:Name="CodexAccountDetailsText" Text="Open Settings to read the local Codex account state." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.Name="Codex account details" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button x:Name="RefreshCodexButton" Content="Refresh" Click="RefreshCodexButton_Click" AutomationProperties.Name="Refresh Codex account, usage, and model information" />
                                                <Button x:Name="SignOutCodexButton" Content="Sign out" Click="SignOutCodexButton_Click" AutomationProperties.Name="Sign out of Codex" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="BrowserLoginCodexButton" Content="Sign in with browser" Click="BrowserLoginCodexButton_Click" AutomationProperties.Name="Sign in to Codex with a browser" />
                                            <Button x:Name="DeviceLoginCodexButton" Content="Use device code" Click="DeviceLoginCodexButton_Click" AutomationProperties.Name="Sign in to Codex with a device code" />
                                        </StackPanel>
                                        <TextBlock x:Name="CodexLoginStatusText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel x:Name="CodexDeviceCodePanel" Visibility="Collapsed" Spacing="6">
                                            <TextBlock Text="Enter this code in the verification page" FontWeight="SemiBold" />
                                            <TextBlock x:Name="CodexDeviceCodeText" Text="" FontFamily="Cascadia Mono" FontSize="18" AutomationProperties.Name="Codex device code" />
                                            <TextBlock x:Name="CodexDeviceVerificationUrlText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.Name="Codex device verification page" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="OpenCodexDeviceUrlButton" Content="Open verification page" Click="OpenCodexDeviceUrlButton_Click" AutomationProperties.Name="Open Codex device verification page" />
                                                <Button x:Name="CopyCodexDeviceCodeButton" Content="Copy code" Click="CopyCodexDeviceCodeButton_Click" AutomationProperties.Name="Copy Codex device code" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="CancelCodexLoginButton" Content="Cancel sign-in" Click="CancelCodexLoginButton_Click" HorizontalAlignment="Left" AutomationProperties.Name="Cancel Codex sign-in" />
                                        <ProgressRing x:Name="CodexLoadingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="GitHub accounts" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock x:Name="GitHubAccountsStatusText" Text="Not loaded" FontWeight="SemiBold" AutomationProperties.Name="GitHub accounts status" />
                                                <TextBlock x:Name="GitHubAccountsConfigurationText" Text="GitHub sign-in isn’t configured in this preview." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.Name="GitHub account configuration" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                <Button x:Name="RefreshGitHubAccountsButton" Content="Refresh" Click="RefreshGitHubAccountsButton_Click" AutomationProperties.Name="Refresh GitHub accounts" />
                                                <Button x:Name="SignInGitHubButton" Content="Sign in to GitHub" Click="SignInGitHubButton_Click" AutomationProperties.Name="Sign in to GitHub" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="GitHubAccountLoginStatusText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        <StackPanel x:Name="GitHubDeviceAuthorizationPanel" Visibility="Collapsed" Spacing="6">
                                            <TextBlock Text="Enter this code on GitHub" FontWeight="SemiBold" />
                                            <TextBlock x:Name="GitHubDeviceCodeText" Text="" FontFamily="Cascadia Mono" FontSize="18" AutomationProperties.Name="GitHub device code" />
                                            <TextBlock x:Name="GitHubDeviceVerificationUrlText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.Name="GitHub device verification page" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="OpenGitHubDeviceUrlButton" Content="Open verification page" Click="OpenGitHubDeviceUrlButton_Click" AutomationProperties.Name="Open GitHub device verification page" />
                                                <Button x:Name="CopyGitHubDeviceCodeButton" Content="Copy code" Click="CopyGitHubDeviceCodeButton_Click" AutomationProperties.Name="Copy GitHub device code" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="CancelGitHubLoginButton" Content="Cancel sign-in" Click="CancelGitHubLoginButton_Click" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="Cancel GitHub sign-in" />
                                        <ProgressRing x:Name="GitHubAccountsLoadingRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" />
                                        <ListView x:Name="GitHubAccountsList" MaxHeight="220" SelectionMode="Single" SelectionChanged="GitHubAccountsList_SelectionChanged" AutomationProperties.Name="Connected GitHub accounts">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="8,6">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="1" Text="{Binding Details}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <TextBlock x:Name="GitHubAccountsEmptyText" Text="No GitHub accounts are connected." Style="{StaticResource SecondaryTextStyle}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="RemoveGitHubAccountButton" Content="Remove selected account" Click="RemoveGitHubAccountButton_Click" AutomationProperties.Name="Remove selected GitHub account" />
                                            <TextBlock x:Name="GitHubSelectedAccountText" Text="" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.Name="Selected GitHub account" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Usage" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CodexUsageStatusText" Text="Usage is unavailable until Codex responds." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.Name="Codex usage status" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Primary" VerticalAlignment="Center" />
                                            <ProgressBar x:Name="CodexPrimaryUsageBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" AutomationProperties.Name="Codex primary usage" />
                                            <TextBlock x:Name="CodexPrimaryUsageText" Grid.Column="2" Text="—" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Secondary" VerticalAlignment="Center" />
                                            <ProgressBar x:Name="CodexSecondaryUsageBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0" VerticalAlignment="Center" AutomationProperties.Name="Codex secondary usage" />
                                            <TextBlock x:Name="CodexSecondaryUsageText" Grid.Column="2" Text="—" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="CodexUsageResetText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="16,14" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="AI assistance" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="Use one model and reasoning choice for future commit and review actions." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="Model" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CodexModelComboBox" DisplayMemberPath="DisplayName" SelectionChanged="CodexModelComboBox_SelectionChanged" AutomationProperties.Name="Shared Codex model" />
                                        <TextBlock x:Name="CodexSelectedModelDescriptionText" Text="" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="Reasoning effort" FontWeight="SemiBold" />
                                        <ComboBox x:Name="CodexReasoningComboBox" DisplayMemberPath="DisplayName" SelectionChanged="CodexReasoningComboBox_SelectionChanged" AutomationProperties.Name="Shared Codex reasoning effort" />
                                        <TextBlock x:Name="CodexCatalogStatusText" Text="Model choices are unavailable until Codex responds." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Recent repositories" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="Removing a row only forgets it from native recents. It does not delete repository files." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                                <ListView x:Name="RecentRepositoriesList" ItemTemplate="{StaticResource RepositoryRecentRowTemplate}" MaxHeight="220" SelectionMode="Single" SelectionChanged="RecentRepositoriesList_SelectionChanged" AutomationProperties.Name="Recent repositories" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="WelcomePanel" Grid.Row="3" Padding="28" Visibility="Visible">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <Border Width="64" Height="64" CornerRadius="16" Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center">
                                    <Image Source="ms-appx:///Assets/icon-logo.ico" Width="42" Height="42" Stretch="Uniform" AutomationProperties.Name="WinGit logo" />
                                </Border>
                                <TextBlock Text="Welcome to WinGit" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="Choose how you want to start: create a repository, add an existing repository, or clone a repository." Style="{StaticResource SecondaryTextStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Button Content="Create a new repository" Click="CreateRepositoryButton_Click" AutomationProperties.Name="Create a new repository" />
                                    <Button Content="Add an existing repository" Click="OpenRepositoryButton_Click" AutomationProperties.Name="Add an existing repository" />
                                    <Button Content="Clone a repository" Click="CloneRepositoryButton_Click" AutomationProperties.Name="Clone a repository" />
                                </StackPanel>
                                <Expander Header="Getting started with Git" IsExpanded="False" HorizontalAlignment="Stretch" AutomationProperties.Name="Getting started with Git">
                                    <Border Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="Git tracks versions. GitHub hosts shared projects. WinGit works locally with Git repositories." TextWrapping="Wrap" />
                                            <TextBlock Text="1. Configure your name and email in Settings > Git configuration." TextWrapping="Wrap" />
                                            <TextBlock Text="2. Create a repository, add an existing repository, or clone a repository." TextWrapping="Wrap" />
                                            <TextBlock Text="3. Edit files, inspect Changes, stage files, and commit." TextWrapping="Wrap" />
                                            <TextBlock Text="4. Review commits in History." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="4" Padding="18,0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                        <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="NativeVersionText" Text="Native preview" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
