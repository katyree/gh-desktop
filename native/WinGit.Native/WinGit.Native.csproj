<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WinGit.Native</RootNamespace>
    <AssemblyName>WinGit.Native</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinGit.Core\WinGit.Core.csproj" />
  </ItemGroup>

  <!-- Keep the original repository templates available in every build and
       published copy. The native app reads these manifest resources directly. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\app\static\common\gitignore\*.gitignore"
                      LogicalName="WinGit.Native.Templates.GitIgnore.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\app\static\common\choosealicense.com\_licenses\*.txt"
                      LogicalName="WinGit.Native.Templates.License.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- WinUI's generated XBF/PRI files are copied by build targets, but the
       unpackaged publish target does not include those generated artifacts. -->
  <ItemGroup>
    <None Include="Assets\icon-logo.ico"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="IncludeWinUiArtifactsInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" Condition="Exists('$(TargetDir)App.xbf')">
        <RelativePath>App.xbf</RelativePath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)MainWindow.xbf" Condition="Exists('$(TargetDir)MainWindow.xbf')">
        <RelativePath>MainWindow.xbf</RelativePath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)NativeImageDiffView.xbf" Condition="Exists('$(TargetDir)NativeImageDiffView.xbf')">
        <RelativePath>NativeImageDiffView.xbf</RelativePath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)NativeSubmoduleDiffView.xbf" Condition="Exists('$(TargetDir)NativeSubmoduleDiffView.xbf')">
        <RelativePath>NativeSubmoduleDiffView.xbf</RelativePath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" Condition="Exists('$(TargetDir)$(AssemblyName).pri')">
        <RelativePath>$(AssemblyName).pri</RelativePath>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Import Project="CodexRuntime.targets" />
  <Import Project="NativeGitRuntime.targets" />

</Project>
